<!-- INSTANCES — one row per running Minecraft. Several can run at once, each
     with its own profile, so this is a live process list rather than a
     launcher status line. -->
<div id="instances-view" class="hidden w-full h-full flex-col p-7 overflow-hidden">
  <div class="flex items-start justify-between gap-4 mb-5">
    <div class="min-w-0">
      <h2 class="page-title">Instances</h2>
      <p id="instances-subtitle" class="text-[12px] text-white/40 mt-1">Nothing is running</p>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <button type="button" id="instances-stop-all" onclick="stopAllInstances()" disabled
              class="h-8 px-3 rounded-md bg-white/[0.06] hover:bg-[#e04f4f]/18 border border-white/10 hover:border-[#e04f4f]/35 disabled:opacity-40 disabled:hover:bg-white/[0.06] disabled:hover:border-white/10 text-[11px] font-medium text-white/80 hover:text-[#ef8b8b] disabled:text-white/40 transition-colors cursor-pointer disabled:cursor-default">
        Stop all
      </button>
      <button type="button" onclick="openLaunchPicker()"
              class="h-8 px-3 rounded-md bg-white hover:bg-white/90 text-[#0b0b0e] text-[11px] font-semibold flex items-center gap-1.5 transition-colors cursor-pointer">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>
        Launch
      </button>
    </div>
  </div>

  <div id="instances-body" class="flex-1 overflow-y-auto custom-scrollbar pr-1">
    <div id="instances-list" class="flex flex-col gap-2"></div>

    <div id="instances-empty" class="flex flex-col items-center justify-center gap-2 h-full min-h-[220px] text-center">
      <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.07] flex items-center justify-center">
        <svg class="w-4 h-4 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="2" y="3" width="20" height="7" rx="2"></rect>
          <rect x="2" y="14" width="20" height="7" rx="2"></rect>
          <line x1="6" y1="6.5" x2="6.01" y2="6.5"></line>
          <line x1="6" y1="17.5" x2="6.01" y2="17.5"></line>
        </svg>
      </div>
      <p class="text-[12px] font-medium text-white/45">No instances running</p>
      <p class="text-[11px] text-white/25 max-w-[280px]">Start a profile from Play, or launch one directly — several can run side by side.</p>
    </div>
  </div>

  <!-- Launch picker: starting a second instance should not mean going back to
       Play and switching the active profile first. The panel is width-capped
       but allowed to shrink on a narrow window, and `px-3` on the list is what
       gives the hover ring on the first/last row room to breathe. -->
  <div id="launch-picker" class="hidden fixed inset-0 z-[70] items-center justify-center p-4 bg-black/70 backdrop-blur-md">
    <div class="surface-modal w-full max-w-[420px] max-h-[440px] flex flex-col overflow-hidden">
      <div class="px-5 pt-4 pb-3 border-b border-white/[0.07] flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-[13px] font-semibold text-white truncate">Launch a profile</h3>
          <p class="text-[11px] text-white/35 mt-1">Running instances stay open.</p>
        </div>
        <button type="button" onclick="closeLaunchPicker()" aria-label="Close launch picker"
                class="w-6 h-6 shrink-0 flex items-center justify-center rounded text-white/35 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div id="launch-picker-list" class="block min-w-0 flex-1 overflow-y-auto overflow-x-hidden custom-scrollbar px-3 py-2.5 flex flex-col gap-1.5"></div>
    </div>
  </div>
</div>
