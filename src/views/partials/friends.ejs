<!-- Friends are keyed by Minecraft UUID and live on the content server, so the
     same account sees the same list from any PC. -->
<div id="friends-view" class="hidden w-full h-full flex-col p-7 overflow-hidden">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="page-title">Friends</h2>
      <p id="friends-subtitle" class="text-[12px] text-white/40 mt-1">Connect with other players</p>
    </div>
    <button type="button" onclick="openAddFriendModal()"
            class="btn-smooth h-8 px-3 rounded-md bg-white/10 hover:bg-white/15 text-white text-[12px] font-medium flex items-center gap-2 cursor-pointer">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Add Friend
    </button>
  </div>

  <div class="flex-1 flex gap-5 overflow-hidden">
    <!-- Left column: requests, friends, then anyone else online -->
    <div class="w-[300px] shrink-0 overflow-y-auto pr-1 custom-scrollbar">
      <div class="flex flex-col gap-1.5 pb-4">
        <div id="friend-requests-section" class="hidden">
          <h3 class="text-[11px] font-medium text-white/50 px-2 mb-2">Friend Requests</h3>
          <div id="friend-requests-list" class="flex flex-col gap-1"></div>
        </div>

        <h3 class="text-[11px] font-medium text-white/50 px-2 mb-2">Friends</h3>
        <div id="friends-list" class="flex flex-col gap-1"></div>

        <div id="online-players-section" class="hidden">
          <h3 class="text-[11px] font-medium text-white/50 px-2 mb-2">Online Now</h3>
          <div id="online-players-list" class="flex flex-col gap-1"></div>
        </div>
      </div>
    </div>

    <!-- Right column: conversation with the selected friend -->
    <div class="panel flex-1 min-w-0 rounded-xl p-5 overflow-y-auto custom-scrollbar flex flex-col">
      <div id="friend-chat-header" class="hidden mb-4 pb-4 border-b border-white/[0.07]">
        <div class="flex items-center gap-3">
          <img id="chat-friend-avatar" src="" alt="" class="w-10 h-10 rounded-full ring-1 ring-white/15" />
          <div>
            <h3 id="chat-friend-name" class="text-[13px] font-semibold text-white"></h3>
            <p id="chat-friend-status" class="text-[11px] text-white/40">Offline</p>
          </div>
        </div>
        <div class="flex items-center gap-2 mt-3">
          <button type="button" onclick="closeChat()" class="h-7 px-2.5 rounded-md bg-white/[0.06] hover:bg-white/[0.1] text-[11px] font-medium text-white/70 transition-colors cursor-pointer">Back</button>
          <button type="button" onclick="inviteToGame()" id="chat-invite-btn" class="h-7 px-2.5 rounded-md bg-white/10 hover:bg-white/15 text-[11px] font-medium text-white transition-colors cursor-pointer">Invite to Game</button>
        </div>
      </div>

      <div id="chat-messages" class="flex-1 overflow-y-auto custom-scrollbar space-y-3 pb-4 hidden">
        <div id="chat-messages-list"></div>
      </div>

      <div id="chat-input-area" class="hidden border-t border-white/[0.07] pt-4">
        <form onsubmit="sendChatMessage(event)" class="flex gap-2">
          <input type="text" id="chat-message-input" placeholder="Type a message…" maxlength="240"
                 class="flex-1 h-9 bg-[#121317] border border-white/10 focus:border-white/25 rounded-md px-3 text-[12px] text-white placeholder-white/30 focus:outline-none transition-colors" />
          <button type="submit" class="btn-smooth h-9 px-4 rounded-md bg-white hover:bg-white/90 text-[#0b0b0e] text-[12px] font-semibold cursor-pointer">Send</button>
        </form>
      </div>

      <div id="chat-empty-state" class="flex-1 flex flex-col items-center justify-center text-center text-white/30 py-12">
        <svg class="w-12 h-12 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path></svg>
        <p class="text-[13px] font-medium text-white">Select a friend to start chatting</p>
        <p class="text-[11px] mt-1 max-w-[300px]">Click on a friend in the list to open a conversation, or add a new friend using the button above.</p>
      </div>
    </div>
  </div>
</div>

<!-- Add Friend modal -->
<div id="add-friend-modal" class="hidden fixed inset-0 z-[70] items-center justify-center bg-black/80 backdrop-blur-md">
  <div class="surface-modal w-[400px] p-5">
    <div class="flex items-start justify-between gap-4 mb-5">
      <div>
        <h2 class="text-[13px] font-semibold text-white">Add Friend</h2>
        <p class="text-[11px] text-white/40 mt-1">Enter their Minecraft username</p>
      </div>
      <button type="button" onclick="closeAddFriendModal()" aria-label="Close" class="text-white/40 hover:text-white p-1 -mt-1 -mr-1 rounded-md cursor-pointer">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <form onsubmit="submitAddFriend(event)" class="flex flex-col gap-3">
      <div>
        <label for="add-friend-input" class="block text-[11px] text-white/45 mb-1.5">Username</label>
        <input type="text" id="add-friend-input" placeholder="Notch" maxlength="16"
               class="w-full h-9 bg-black/40 border border-white/15 focus:border-white/30 rounded-md px-3 text-[12px] text-white placeholder-white/25 focus:outline-none transition-colors" required autocomplete="off" />
        <p id="add-friend-error" class="text-[#e0685d] text-[11px] mt-1.5 hidden">Could not find that player.</p>
      </div>

      <div class="flex gap-2 pt-1">
        <button type="button" onclick="closeAddFriendModal()" class="flex-1 h-9 rounded-md bg-white/[0.06] hover:bg-white/10 text-[12px] font-medium text-white/70 cursor-pointer">Cancel</button>
        <button type="submit" id="add-friend-submit" class="flex-1 h-9 rounded-md bg-white hover:bg-white/90 text-[12px] font-semibold text-[#0b0b0e] cursor-pointer">Send Request</button>
      </div>
    </form>
  </div>
</div>
