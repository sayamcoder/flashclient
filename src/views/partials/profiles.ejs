<div id="profiles-view" class="hidden w-full h-full flex-col p-7 overflow-hidden">
  <div class="flex items-start justify-between gap-4 mb-5">
    <div>
      <h2 class="page-title">Profiles</h2>
      <p id="profiles-subtitle" class="text-[12px] text-white/40 mt-1">Loading…</p>
    </div>

    <div class="flex items-center gap-2">
      <button type="button" onclick="openImportModal()"
              class="h-8 px-3 rounded-md bg-white/[0.06] hover:bg-white/[0.1] border border-white/10 text-[11px] font-medium text-white/80 flex items-center gap-1.5 transition-colors cursor-pointer">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Import
      </button>
      <button type="button" onclick="openNewProfileModal()"
              class="h-8 px-3 rounded-md bg-white hover:bg-white/90 text-[#0b0b0e] text-[11px] font-semibold flex items-center gap-1.5 transition-colors cursor-pointer">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New profile
      </button>
    </div>
  </div>

  <div id="profile-setup-note" class="hidden items-center gap-2 -mt-2 mb-4 text-[11px] text-white/45">
    <span class="w-1.5 h-1.5 rounded-full bg-[#5ec36a] animate-pulse"></span>
    <span id="profile-setup-text" class="truncate"></span>
  </div>

  <div class="flex-1 flex gap-5 overflow-hidden">
    <div class="w-[300px] shrink-0 overflow-y-auto pr-1 custom-scrollbar">
      <div id="profiles-list" class="flex flex-col gap-1.5 pb-4"></div>
    </div>

    <div class="panel flex-1 min-w-0 rounded-xl p-5 overflow-y-auto custom-scrollbar">
      <div id="profile-detail"></div>
    </div>
  </div>

  <div id="import-modal" class="hidden fixed inset-0 z-[70] items-center justify-center bg-black/70 backdrop-blur-md">
    <div class="surface-modal w-[520px] max-h-[460px] flex flex-col overflow-hidden">
      <div class="px-5 pt-4 pb-3 border-b border-white/[0.07] flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-[13px] font-semibold text-white">Import from .minecraft</h3>
          <p id="import-root" class="text-[11px] font-mono text-white/35 mt-1 truncate">Looking for an existing Minecraft folder…</p>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button type="button" onclick="browseMinecraftFolder()"
                  class="h-6 px-2 rounded bg-white/[0.06] hover:bg-white/[0.1] text-[11px] font-medium text-white/60 hover:text-white transition-colors cursor-pointer">Browse</button>
          <button type="button" onclick="closeImportModal()" aria-label="Close import"
                  class="w-6 h-6 flex items-center justify-center rounded text-white/35 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
      </div>

      <div id="import-list" class="flex-1 overflow-y-auto custom-scrollbar px-3 py-2"></div>

      <div class="px-4 py-3 border-t border-white/[0.07] flex items-center justify-between gap-3">
        <p id="import-note" class="text-[11px] text-white/35">Existing libraries, assets and mods are reused, so nothing downloads twice.</p>
        <button type="button" id="import-run" onclick="runImport()" disabled
                class="h-8 px-3.5 rounded-md bg-white hover:bg-white/90 disabled:bg-white/[0.07] disabled:text-white/30 text-[#0b0b0e] text-[11px] font-semibold transition-colors cursor-default disabled:cursor-default enabled:cursor-pointer shrink-0">
          Import selected
        </button>
      </div>
    </div>
  </div>

  <div id="new-profile-modal" class="hidden fixed inset-0 z-[70] items-center justify-center bg-black/70 backdrop-blur-md">
    <form id="new-profile-form" onsubmit="createProfile(event)"
          class="surface-modal w-[440px] overflow-hidden">
      <div class="px-5 pt-4 pb-3 border-b border-white/[0.07] flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="text-[13px] font-semibold text-white">New profile</h3>
          <p class="text-[11px] text-white/35 mt-1">Choose the version first — performance mods install for it.</p>
        </div>
        <button type="button" onclick="closeNewProfileModal()" aria-label="Close new profile"
                class="w-6 h-6 shrink-0 flex items-center justify-center rounded text-white/35 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="px-5 py-4 flex flex-col gap-3.5">
        <div>
          <label class="block text-[11px] text-white/35 mb-1">Name</label>
          <input id="np-name" maxlength="40" placeholder="Your profile name"
                 class="w-full h-8 bg-[#121317] border border-white/10 focus:border-white/25 rounded-md px-2 text-[12px] text-white placeholder-white/25 focus:outline-none transition-colors" />
        </div>

        <div>
          <label class="block text-[11px] text-white/35 mb-1">Game version</label>
          <select id="np-version"
                  class="h-8 w-full bg-[#121317] border border-white/10 focus:border-white/25 rounded-md px-2 text-[12px] font-mono text-white focus:outline-none cursor-pointer"></select>
          <p id="np-version-note" class="text-[11px] text-white/30 mt-1.5">Loading Mojang versions…</p>
        </div>

        <div>
          <label class="block text-[11px] text-white/35 mb-1">Loader</label>
          <div id="np-loaders" class="flex gap-0.5 bg-white/[0.04] p-0.5 rounded-md"></div>
          <p class="text-[11px] text-white/30 mt-1.5">Installed with the game on first launch.</p>
        </div>
      </div>

      <div class="px-5 py-3 border-t border-white/[0.07] flex items-center justify-end gap-2">
        <button type="button" onclick="closeNewProfileModal()"
                class="h-8 px-3 rounded-md bg-white/[0.06] hover:bg-white/[0.1] text-[11px] font-medium text-white/70 transition-colors cursor-pointer">Cancel</button>
        <button type="submit" id="np-submit"
                class="h-8 px-3.5 rounded-md bg-white hover:bg-white/90 disabled:bg-white/[0.07] disabled:text-white/30 text-[#0b0b0e] text-[11px] font-semibold transition-colors disabled:cursor-default cursor-pointer">Create profile</button>
      </div>
    </form>
  </div>
</div>
