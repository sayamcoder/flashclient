<!-- TOP BAR — account on the left, environments and sections centred over
     the art, utilities and window controls on the right. Transparent so the
     world backdrop reads through it. -->
<header class="app-drag-region relative z-40 w-full h-16 flex items-center justify-between px-4 select-none">

  <!-- 1. Account -->
  <div class="no-drag relative">
    <button type="button" id="user-profile-badge" onclick="toggleAccountMenu()"
            class="hidden items-center gap-2.5 pl-1.5 pr-2 py-1.5 rounded-lg bg-black/40 border border-white/10 hover:bg-black/60 hover:border-white/20 backdrop-blur-md transition-colors cursor-pointer">
      <img id="nav-user-avatar" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'><rect width='8' height='8' fill='%23b8815a'/></svg>"
           onerror="skinFallback(this)"
           class="w-8 h-8 rounded-md pixelated ring-1 ring-white/15" alt="" />
      <span class="text-left flex flex-col leading-none">
        <span id="nav-username" class="text-[13px] font-semibold text-white leading-none">Player</span>
        <span id="nav-account-type" class="text-[11px] text-white/40 leading-none mt-1">Account</span>
      </span>
      <svg class="w-3 h-3 text-white/40 ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>

    <div id="account-menu" class="hidden absolute top-[52px] left-0 w-52 bg-[#15161b] border border-white/10 rounded-lg p-1 shadow-[0_12px_32px_rgba(0,0,0,0.55)] z-50">
      <button type="button" onclick="copyCurrentUsername()" class="w-full text-left px-2.5 py-2 rounded-md hover:bg-white/[0.07] text-[12px] font-medium text-white/85 hover:text-white cursor-pointer">Copy username</button>
      <button type="button" onclick="switchTab('skins'); toggleAccountMenu()" class="w-full text-left px-2.5 py-2 rounded-md hover:bg-white/[0.07] text-[12px] font-medium text-white/85 hover:text-white cursor-pointer">Change skin</button>
      <button type="button" onclick="openRewards()" class="w-full flex items-center gap-2 px-2.5 py-2 rounded-md hover:bg-white/[0.07] text-[12px] font-medium text-white/85 hover:text-white cursor-pointer">
        <svg class="w-3.5 h-3.5 text-[#f7d774]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="8" width="18" height="13" rx="2"></rect><path d="M3 12h18"></path><path d="M12 8v13"></path><path d="M7.5 8a2.5 2.5 0 010-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 010 5"></path></svg>
        <span>Daily rewards</span>
        <span id="account-reward-dot" class="ml-auto w-1.5 h-1.5 rounded-full bg-[#f7d774] hidden"></span>
      </button>
      <div class="h-px bg-white/[0.07] my-1"></div>
      <button type="button" onclick="handleLogout()" class="w-full text-left px-2.5 py-2 rounded-md hover:bg-[#e04f4f]/15 text-[12px] font-medium text-[#ef8b8b] cursor-pointer">Switch account</button>
    </div>
  </div>

  <!-- 2. Environments + sections, held dead centre of the window -->
  <nav id="dashboard-nav" class="no-drag hidden absolute left-1/2 -translate-x-1/2 top-2 flex-col items-center gap-2">
    <div class="relative">
      <button type="button" id="env-tiles" onclick="toggleEnvPicker()"
              title="Switch version" aria-haspopup="true" aria-expanded="false"
              class="env-tile font-mono"></button>
      <div id="env-picker" class="hidden absolute top-[34px] left-1/2 -translate-x-1/2 w-[272px] max-h-[420px] overflow-y-auto bg-[#15161b] border border-white/10 rounded-xl p-1 shadow-[0_16px_40px_rgba(0,0,0,0.6)] z-50"></div>
    </div>
    <div class="flex items-center px-1 py-1 rounded-lg bg-black/40 border border-white/10 backdrop-blur-md">
      <button type="button" onclick="switchTab('play')" data-tab="play" class="nav-tab is-active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="7 4 20 12 7 20 7 4"></polygon></svg>
        <span>Play</span>
      </button>
      <span class="tab-divider"></span>
      <button type="button" onclick="switchTab('profiles')" data-tab="profiles" class="nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        <span>Profiles</span>
      </button>
      <span class="tab-divider"></span>

      <!-- Only visible while something is running: the count is the reason to
           look here at all. -->
      <button type="button" id="instances-tab" onclick="switchTab('instances')" data-tab="instances" class="nav-tab hidden">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="3" width="20" height="7" rx="2"></rect><rect x="2" y="14" width="20" height="7" rx="2"></rect><line x1="6" y1="6.5" x2="6.01" y2="6.5"></line><line x1="6" y1="17.5" x2="6.01" y2="17.5"></line></svg>
        <span>Instances</span>
        <span id="instances-badge" class="hidden items-center justify-center ml-0.5 min-w-[15px] h-[15px] px-1 rounded-full bg-[#4cbb5e]/20 border border-[#4cbb5e]/35 text-[10px] font-mono font-semibold text-[#7fe08d]">
          <span id="instances-badge-count">0</span>
        </span>
      </button>
      <span class="tab-divider" id="instances-tab-divider"></span>

      <!-- Mods, shaders, packs, skins and cosmetics share one slot so the row
           stays readable; the label follows whichever one is open. -->
      <div class="relative">
        <button type="button" id="content-menu-btn" data-tab="content" onclick="toggleContentMenu()"
                aria-haspopup="true" aria-expanded="false" class="nav-tab">
          <svg id="content-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
          <span id="content-menu-label">Content</span>
          <svg class="w-2.5 h-2.5 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <div id="content-menu" class="hidden absolute top-[36px] left-1/2 -translate-x-1/2 w-[196px] bg-[#15161b] border border-white/10 rounded-xl p-1 shadow-[0_16px_40px_rgba(0,0,0,0.6)] z-50">
          <button type="button" data-content-tab="mods" onclick="switchTab('mods')" class="content-menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 8l-9-5-9 5 9 5 9-5z"></path><path d="M3 8v8l9 5 9-5V8"></path><path d="M12 13v8"></path></svg>
            <span>Mods</span>
          </button>
          <button type="button" data-content-tab="shaders" onclick="switchTab('shaders')" class="content-menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
            <span>Shaders</span>
          </button>
          <button type="button" data-content-tab="resourcepacks" onclick="switchTab('resourcepacks')" class="content-menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Resource Packs</span>
          </button>
          <button type="button" data-content-tab="skins" onclick="switchTab('skins')" class="content-menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>Skins</span>
          </button>
          <button type="button" data-content-tab="cosmetics" onclick="switchTab('cosmetics')" class="content-menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"></path><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z"></path></svg>
            <span>Cosmetics</span>
          </button>
        </div>
      </div>

      <span class="tab-divider"></span>
      <button type="button" onclick="switchTab('friends')" data-tab="friends" class="nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 00-3-3.87"></path><path d="M16 3.13a4 4 0 010 7.75"></path></svg>
        <span>Friends</span>
      </button>
      <span class="tab-divider"></span>
      <button type="button" onclick="switchTab('servers')" data-tab="servers" class="nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="3" width="20" height="7" rx="2"></rect><rect x="2" y="14" width="20" height="7" rx="2"></rect><line x1="6" y1="6.5" x2="6.01" y2="6.5"></line><line x1="6" y1="17.5" x2="6.01" y2="17.5"></line></svg>
        <span>Servers</span>
      </button>
    </div>
  </nav>

  <!-- 3. Utilities + window controls -->
  <div class="no-drag flex items-center space-x-1">
    <!-- Only meaningful once there is a session to launch into. -->
    <div id="dashboard-utilities" class="hidden items-center space-x-1">
      <!-- Appears only when the feed has something newer than this build. -->
      <button type="button" id="update-button" onclick="handleUpdatePill()" title="Launcher update"
              class="hidden items-center gap-1.5 h-8 px-2.5 rounded-lg bg-[#e04f4f]/[0.14] border border-[#e04f4f]/30 hover:bg-[#e04f4f]/25 text-[11px] font-semibold text-[#f0a0a0] btn-smooth cursor-pointer">
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 11-3.5-7.1"></path><polyline points="21 3 21 9 15 9"></polyline></svg>
        <span id="update-button-label">Update</span>
      </button>

      <button type="button" id="reward-chip" onclick="openRewards()" title="Daily rewards and wallet"
              class="reward-chip relative flex items-center gap-1.5 h-8 pl-1.5 pr-2.5 rounded-lg text-[11px] font-semibold text-white/80 hover:text-white btn-smooth cursor-pointer">
        <span class="reward-coin">F</span>
        <span id="reward-chip-coins">—</span>
        <span id="reward-claim-dot" class="reward-dot hidden"></span>
      </button>

      <button type="button" id="news-button" onclick="openNewsSheet()" title="News and patch notes" aria-label="News and patch notes"
              class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 text-white/55 hover:text-white transition-colors cursor-pointer">
        <svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1"></rect><line x1="9" y1="12" x2="15" y2="12"></line><line x1="9" y1="16" x2="13" y2="16"></line></svg>
      </button>

      <button type="button" onclick="switchTab('settings')" title="Settings" aria-label="Settings"
              class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 text-white/55 hover:text-white transition-colors cursor-pointer">
        <svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 008 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.6 15a1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.6a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"></path></svg>
      </button>

      <div class="w-px h-5 bg-white/10 mx-1"></div>
    </div>

    <button onclick="window.electronAPI?.minimize()" aria-label="Minimize" class="w-8 h-8 flex items-center justify-center rounded-md hover:bg-white/10 text-white/50 hover:text-white transition-colors cursor-pointer">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
    </button>
    <button id="window-max-btn" onclick="toggleWindowMaximize()" aria-label="Maximize" title="Maximize"
            class="w-8 h-8 flex items-center justify-center rounded-md hover:bg-white/10 text-white/50 hover:text-white transition-colors cursor-pointer">
      <svg id="window-max-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="5" y="5" width="14" height="14" rx="1.5"></rect></svg>
      <svg id="window-restore-icon" class="hidden w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="4" y="8" width="12" height="12" rx="1.5"></rect><path d="M8 8V5.5A1.5 1.5 0 019.5 4H18a2 2 0 012 2v8.5a1.5 1.5 0 01-1.5 1.5H16"></path></svg>
    </button>
    <button onclick="window.electronAPI?.close()" aria-label="Close" class="w-8 h-8 flex items-center justify-center rounded-md hover:bg-[#e04f4f]/25 hover:text-white text-white/50 transition-colors cursor-pointer">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
</header>
