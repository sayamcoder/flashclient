<div id="skins-view" class="hidden w-full h-full flex-col px-7 py-6 overflow-hidden">
  <div class="mb-4">
    <h2 class="page-title">Skins</h2>
    <p class="text-[12px] text-white/40 mt-1">Pick a skin or add your own</p>
  </div>

  <div class="flex items-center gap-2.5 mb-5">
    <input 
      type="text" 
      id="skin-search-input" 
      placeholder="Minecraft username" 
      class="flex-1 h-9 bg-[#121317] border border-white/10 focus:border-white/25 rounded-md px-3 text-[12px] text-white placeholder-white/30 focus:outline-none transition-colors"
    />
    <input type="file" id="skin-file-input" accept=".png" class="hidden" onchange="handleSkinFileUpload(event)" />
    <button 
      type="button" 
      onclick="document.getElementById('skin-file-input').click()"
      class="btn-smooth h-9 px-4 rounded-md bg-white/10 hover:bg-white/15 text-white text-[12px] font-medium flex items-center gap-2 cursor-pointer"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
      <span>Upload PNG</span>
    </button>
  </div>

  <div class="flex-1 flex gap-5 overflow-hidden">
    <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">
      <div id="skins-grid" class="grid grid-cols-[repeat(auto-fill,minmax(118px,1fr))] gap-2.5"></div>
    </div>

    <div class="w-[360px] h-full flex flex-col justify-between bg-[#121317] border border-white/10 rounded-lg p-4">
      <div class="flex items-start justify-between gap-3 pb-3 border-b border-white/[0.07]">
        <div class="min-w-0">
          <span class="block text-[11px] text-white/35">Skin</span>
          <span id="preview-skin-name" class="block text-[12px] font-medium text-white mt-1 truncate">Current skin</span>
        </div>
        <div>
          <span class="block text-[11px] text-white/35 mb-1">Model</span>
          <div class="flex gap-0.5 bg-white/[0.05] p-0.5 rounded-md">
            <button type="button" onclick="setSkinModel('classic')" id="model-classic-btn" class="px-2 py-0.5 text-[11px] font-medium rounded text-white bg-white/10 cursor-pointer">Classic</button>
            <button type="button" onclick="setSkinModel('slim')" id="model-slim-btn" class="px-2 py-0.5 text-[11px] font-medium rounded text-white/40 hover:text-white cursor-pointer">Slim</button>
          </div>
        </div>
      </div>

      <div id="skin-stage-bg" class="flex-1 my-3 rounded-md overflow-hidden relative flex items-center justify-center border border-white/[0.07] bg-cover bg-center" style="background-image: url('images/stage-meadow-2048x2048.png');">
        <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 72% 68% at 50% 44%, rgba(9,9,11,0) 30%, rgba(9,9,11,0.62) 100%)"></div>
        <img 
          id="preview-full-body" 
          src="https://mc-heads.net/body/Steve/right" 
          alt="Selected skin" 
          onerror="skinFallback(this)"
          class="h-[80%] max-h-[260px] object-contain drop-shadow-[0_12px_24px_rgba(0,0,0,0.8)] pixelated relative z-10"
        />
      </div>

      <div class="flex items-center justify-between pt-1">
        <select id="panorama-select" onchange="changePanorama(this.value)" class="h-8 pl-2 pr-1 bg-white/[0.05] border border-white/10 rounded-md text-[11px] text-white/70 focus:outline-none cursor-pointer">
          <option value="meadow">Honey meadow</option>
          <option value="sunset">Sunset bay</option>
        </select>
        
        <button 
          type="button" 
          onclick="applyCurrentSkin()" 
          class="btn-smooth h-8 px-4 rounded-md bg-white hover:bg-white/90 text-[#0b0b0e] text-[12px] font-semibold cursor-pointer"
        >
          Apply
        </button>
      </div>
    </div>
  </div>
</div>
