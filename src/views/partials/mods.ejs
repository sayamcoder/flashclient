<div id="mods-view" class="hidden w-full h-full flex-col p-7 overflow-hidden">
  <div class="flex items-start justify-between gap-4 mb-5">
    <div>
      <h2 class="page-title">Mods</h2>
      <p id="mods-subtitle" class="text-[12px] text-white/40 mt-1">Loading…</p>
    </div>

    <div class="flex items-center gap-2">
      <select id="mods-profile-select" onchange="setModsProfile(this.value)" aria-label="Minecraft version"
              class="hidden h-8 max-w-[260px] bg-[#121317] border border-white/10 focus:border-white/25 rounded-md px-2 text-[11px] font-mono text-white/80 focus:outline-none cursor-pointer"></select>

      <div class="flex gap-0.5 bg-white/[0.05] p-0.5 rounded-md">
        <button type="button" id="mods-tab-installed" onclick="setModsMode('installed')"
                class="px-2.5 py-1 text-[11px] font-medium rounded text-white bg-white/10 cursor-pointer">Installed</button>
        <button type="button" id="mods-tab-browse" onclick="setModsMode('browse')"
                class="px-2.5 py-1 text-[11px] font-medium rounded text-white/40 hover:text-white cursor-pointer">Browse</button>
        <button type="button" id="mods-tab-modpacks" onclick="setModsMode('modpacks')"
                class="px-2.5 py-1 text-[11px] font-medium rounded text-white/40 hover:text-white cursor-pointer">Modpacks</button>
      </div>

      <button type="button" onclick="openModsFolder()" title="Open mods folder" aria-label="Open mods folder"
              class="w-8 h-8 flex items-center justify-center rounded-md bg-white/[0.05] hover:bg-white/10 text-white/55 hover:text-white transition-colors cursor-pointer">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"></path></svg>
      </button>
    </div>
  </div>

  <div id="mods-search-row" class="hidden mb-4">
    <input type="text" id="mod-search-input" oninput="filterMods(this.value)" placeholder="Search Modrinth"
           class="w-full h-9 bg-[#121317] border border-white/10 focus:border-white/25 rounded-md px-3 text-[12px] text-white placeholder-white/30 focus:outline-none transition-colors" />
  </div>

  <div id="mods-pack-note" class="hidden items-center gap-2.5 mb-4 px-3.5 py-2.5 rounded-lg bg-white/[0.03] border border-white/[0.06]">
    <svg class="w-3.5 h-3.5 text-white/35 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 8l-9-5-9 5 9 5 9-5z"></path><path d="M3 8v8l9 5 9-5V8"></path><path d="M12 13v8"></path></svg>
    <p class="text-[11px] text-white/40 leading-relaxed">A modpack installs as its own profile. Your current setup stays untouched.</p>
  </div>

  <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">
    <div id="mods-list" class="flex flex-col gap-2 pb-4"></div>
  </div>
</div>
